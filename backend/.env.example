# PostgreSQL connection
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/hyperlocal_chat

# App
APP_ENV=local
LOG_LEVEL=INFO

# JWT — generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=604800

# Message expiration — messages live MESSAGE_RETENTION_HOURS from creation, then
# the cleanup job (runs every MESSAGE_CLEANUP_INTERVAL_MINUTES) deletes them.
# Rooms are never deleted by message expiration.
MESSAGE_RETENTION_HOURS=24
MESSAGE_CLEANUP_INTERVAL_MINUTES=60
# Optional: also delete rooms with no activity for ROOM_RETENTION_DAYS.
# Disabled by default — rooms (including empty ones) otherwise persist forever.
ROOM_RETENTION_DAYS=30
ENABLE_ROOM_CLEANUP=false
